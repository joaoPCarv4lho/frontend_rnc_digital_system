# Exemplo de variáveis de ambiente para o app Vite
# Não coloque segredos reais aqui. Preencha este arquivo localmente seguindo o README.

# URL base da API (usada em src/services/api.ts)
VITE_API_URL=https://api.example.com

# Modo MOCK: quando "true", o app usa dados simulados (usuários e RNCs) e não
# faz chamadas ao backend real. Útil para demonstrações e prints de portfólio.
# Deixe vazio ou "false" para usar a API real.
VITE_USE_MOCK=false

# Exemplos opcionais (descomente/edite conforme necessário)
# VITE_APP_NAME=RNC Digital System
# VITE_SENTRY_DSN=
# VITE_OTHER_KEY=

# Observações:
# - Variáveis Vite devem começar com VITE_.
# - Não commite o arquivo `.env` com valores reais/secretos.
